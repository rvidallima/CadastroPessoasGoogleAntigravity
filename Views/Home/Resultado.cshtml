@model CadastroAlunos.Models.ResultadoValidacao
@{
    ViewData["Title"] = Model.IsValido ? "Documento Válido - Cadastro Confirmado" : "Atenção - Documento Não Validado";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        
        <!-- PARECER PRINCIPAL COM DESTAQUE VISUAL -->
        @if (Model.IsValido)
        {
            <div class="card card-custom p-4 p-md-5 mb-4 border border-3 border-success text-center bg-white shadow">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-success text-white rounded-circle" style="width: 90px; height: 90px;">
                        <i class="bi bi-shield-check fs-1"></i>
                    </div>
                </div>
                <span class="badge bg-success fs-6 px-3 py-2 mb-2 align-self-center">
                    <i class="bi bi-check-circle-fill me-1"></i> DOCUMENTO VÁLIDO & APROVADO
                </span>
                <h1 class="h2 fw-bold text-success mb-2">@Model.TituloParecer</h1>
                <p class="fs-5 text-dark mb-3 px-md-4">
                    @Model.MensagemPrincipal
                </p>
                <div class="d-flex justify-content-center gap-3">
                    <div class="badge bg-light text-dark border p-2 fs-6">
                        <i class="bi bi-cpu-fill text-primary me-1"></i> Grau de Correspondência: <strong>@Model.PontuacaoConfianca%</strong>
                    </div>
                    <div class="badge bg-light text-dark border p-2 fs-6">
                        <i class="bi bi-cloud-check-fill text-success me-1"></i> Gravado no Firebase
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="card card-custom p-4 p-md-5 mb-4 border border-3 border-danger text-center bg-white shadow">
                <div class="mb-3">
                    <div class="d-inline-flex align-items-center justify-content-center bg-danger text-white rounded-circle" style="width: 90px; height: 90px;">
                        <i class="bi bi-exclamation-triangle-fill fs-1"></i>
                    </div>
                </div>
                <span class="badge bg-danger fs-6 px-3 py-2 mb-2 align-self-center">
                    <i class="bi bi-x-circle-fill me-1"></i> DOCUMENTO COM DIVERGÊNCIAS
                </span>
                <h1 class="h2 fw-bold text-danger mb-2">@Model.TituloParecer</h1>
                <p class="fs-5 text-dark mb-3 px-md-4">
                    @Model.MensagemPrincipal
                </p>
                <div class="alert alert-warning text-start mx-auto col-md-10 mb-0" role="alert">
                    <h6 class="fw-bold mb-1"><i class="bi bi-info-circle-fill me-1"></i> O que você pode fazer:</h6>
                    <ul class="mb-0 small">
                        <li>Verifique se o arquivo anexado é realmente a foto ou o PDF do seu documento (RG).</li>
                        <li>Caso tenha tirado uma foto, certifique-se de que o ambiente estava bem iluminado e os textos legíveis.</li>
                        <li>Verifique se o seu nome foi digitado exatamente igual ao que está impresso no RG.</li>
                    </ul>
                </div>
            </div>
        }

        <div class="row g-4 mb-4">
            <!-- DETALHES DA CONFERÊNCIA AUTOMÁTICA -->
            <div class="col-md-6">
                <div class="card card-custom p-4 h-100">
                    <h4 class="h5 fw-bold text-dark mb-3 d-flex align-items-center">
                        <i class="bi bi-search text-primary me-2"></i> Relatório da Conferência
                    </h4>

                    @if (Model.DetalhesConferencia != null && Model.DetalhesConferencia.Any())
                    {
                        <div class="mb-3">
                            <h6 class="text-success fw-bold small text-uppercase">Itens Confirmados:</h6>
                            <ul class="list-group list-group-flush mb-0">
                                @foreach (var detalhe in Model.DetalhesConferencia)
                                {
                                    <li class="list-group-item px-0 py-2 d-flex align-items-start">
                                        <i class="bi bi-check-circle-fill text-success fs-5 me-2 mt-n1"></i>
                                        <span>@detalhe</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (Model.Alertas != null && Model.Alertas.Any())
                    {
                        <div>
                            <h6 class="text-warning fw-bold small text-uppercase">Observações e Alertas:</h6>
                            <ul class="list-group list-group-flush mb-0">
                                @foreach (var alerta in Model.Alertas)
                                {
                                    <li class="list-group-item px-0 py-2 d-flex align-items-start text-danger">
                                        <i class="bi bi-exclamation-circle-fill fs-5 me-2 mt-n1"></i>
                                        <span>@alerta</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.TextoExtraidoPreview))
                    {
                        <div class="mt-3 pt-3 border-top">
                            <h6 class="fw-bold small text-muted text-uppercase mb-1">
                                <i class="bi bi-file-text me-1"></i> Trecho lido pelo motor do sistema:
                            </h6>
                            <p class="small text-muted font-monospace bg-light p-2 rounded mb-0">
                                @Model.TextoExtraidoPreview
                            </p>
                        </div>
                    }
                </div>
            </div>

            <!-- DADOS CADASTRAIS SALVOS -->
            <div class="col-md-6">
                <div class="card card-custom p-4 h-100">
                    <h4 class="h5 fw-bold text-dark mb-3 d-flex align-items-center">
                        <i class="bi bi-card-checklist text-primary me-2"></i> Dados Cadastrados no Sistema
                    </h4>

                    <table class="table table-sm table-borderless mb-0">
                        <tbody>
                            <tr>
                                <th class="text-muted" style="width: 35%;">Nome Aluno:</th>
                                <td class="fw-bold text-dark">@Model.Aluno.NomeCompleto</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Mãe:</th>
                                <td>@Model.Aluno.NomeDaMae</td>
                            </tr>
                            <tr>
                                <th class="text-muted">Pai:</th>
                                <td>
                                    @if (Model.Aluno.PaiNaoDeclarado)
                                    {
                                        <span class="badge bg-secondary">Não declarado</span>
                                    }
                                    else
                                    {
                                        @(string.IsNullOrWhiteSpace(Model.Aluno.NomeDoPai) ? "-" : Model.Aluno.NomeDoPai)
                                    }
                                </td>
                            </tr>
                            @if (!string.IsNullOrWhiteSpace(Model.Aluno.NumeroRg))
                            {
                                <tr>
                                    <th class="text-muted">RG Informado:</th>
                                    <td class="font-monospace">@Model.Aluno.NumeroRg</td>
                                </tr>
                            }
                            <tr>
                                <th class="text-muted">Endereço:</th>
                                <td>
                                    @Model.Aluno.Logradouro, @Model.Aluno.Numero
                                    @if (!string.IsNullOrWhiteSpace(Model.Aluno.Complemento))
                                    {
                                        <span> - @Model.Aluno.Complemento</span>
                                    }
                                    <br />
                                    @Model.Aluno.Bairro - @Model.Aluno.Cidade/@Model.Aluno.Estado
                                    <br />
                                    <span class="small text-muted">CEP: @Model.Aluno.Cep</span>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <div class="mt-3 pt-3 border-top">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <div class="small fw-bold text-dark">
                                    <i class="bi bi-file-earmark-check text-primary me-1"></i> Documento Anexado:
                                </div>
                                <div class="small text-muted">
                                    @Model.DocumentoNomeArquivo (@Model.DocumentoTamanhoFormatado)
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(Model.DocumentoUrlOuCaminho))
                            {
                                <a href="@Model.DocumentoUrlOuCaminho" target="_blank" class="btn btn-sm btn-outline-primary" title="Abrir arquivo do documento em nova aba">
                                    <i class="bi bi-box-arrow-up-right me-1"></i> Ver RG
                                </a>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- PROTOCOLO FIREBASE E BOTÕES DE AÇÃO -->
        <div class="card card-custom p-4 bg-light text-center mb-5">
            <div class="row align-items-center mb-3">
                <div class="col-md-6 text-md-start mb-2 mb-md-0">
                    <span class="text-muted small">ID do Registro no Firebase:</span>
                    <div class="font-monospace fw-bold text-primary">@Model.FirebaseRegistroId</div>
                </div>
                <div class="col-md-6 text-md-end">
                    <span class="text-muted small">Data e Hora do Registro:</span>
                    <div class="fw-semibold text-dark">@Model.DataProcessamento.ToString("dd/MM/yyyy HH:mm:ss")</div>
                </div>
            </div>

            <div class="d-flex flex-wrap justify-content-center gap-3 pt-2 border-top">
                <button type="button" class="btn btn-outline-secondary px-4 py-2" onclick="window.print();">
                    <i class="bi bi-printer me-2"></i> Imprimir Comprovante
                </button>
                <a asp-action="Index" class="btn btn-custom-primary px-4 py-2">
                    <i class="bi bi-person-plus-fill me-2"></i> Realizar Novo Cadastro
                </a>
                <a asp-action="Alunos" class="btn btn-outline-primary px-4 py-2">
                    <i class="bi bi-people-fill me-2"></i> Ver Lista de Alunos
                </a>
            </div>
        </div>

    </div>
</div>

