@model List<CadastroAlunos.Models.AlunoRegistroEntity>
@{
    ViewData["Title"] = "Alunos Cadastrados";
}

<div class="card card-custom p-4 p-md-5 mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4 pb-3 border-bottom">
        <div>
            <h1 class="h3 fw-bold mb-1 text-primary">
                <i class="bi bi-people-fill me-2"></i> Alunos Cadastrados & Validação de Documentos
            </h1>
            <p class="text-muted mb-0">
                Lista de matrículas e verificação de RG gravadas no Firebase.
            </p>
        </div>
        <a asp-action="Index" class="btn btn-custom-primary">
            <i class="bi bi-person-plus-fill me-1"></i> Novo Cadastro
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-folder-x fs-1 text-muted mb-3 d-block"></i>
            <h4 class="text-muted fw-bold">Nenhum aluno cadastrado até o momento</h4>
            <p class="text-muted mb-3">Seja o primeiro a realizar o cadastro no sistema.</p>
            <a asp-action="Index" class="btn btn-primary px-4">Cadastrar Agora</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead class="table-light">
                    <tr>
                        <th>Status do Documento</th>
                        <th>Nome do Aluno</th>
                        <th>Filiação (Mãe)</th>
                        <th>Cidade / UF</th>
                        <th>Data do Envio</th>
                        <th>Documento</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var aluno in Model)
                    {
                        <tr>
                            <td>
                                @if (aluno.DocumentoValido)
                                {
                                    <span class="badge bg-success py-2 px-3">
                                        <i class="bi bi-check-circle-fill me-1"></i> Válido (@aluno.PontuacaoConfianca%)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger py-2 px-3">
                                        <i class="bi bi-exclamation-triangle-fill me-1"></i> Divergente (@aluno.PontuacaoConfianca%)
                                    </span>
                                }
                            </td>
                            <td>
                                <span class="fw-bold text-dark">@aluno.NomeCompleto</span>
                                @if (!string.IsNullOrWhiteSpace(aluno.NumeroRg))
                                {
                                    <span class="d-block small text-muted">RG: @aluno.NumeroRg</span>
                                }
                            </td>
                            <td>@aluno.NomeDaMae</td>
                            <td>@aluno.Cidade/@aluno.Estado</td>
                            <td>@aluno.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                            <td>
                                @if (!string.IsNullOrWhiteSpace(aluno.DocumentoUrl))
                                {
                                    <a href="@aluno.DocumentoUrl" target="_blank" class="btn btn-sm btn-outline-secondary" title="Visualizar documento anexado">
                                        <i class="bi bi-file-earmark-arrow-down me-1"></i> Ver RG
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted small">Sem arquivo</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Resultado" asp-route-id="@aluno.Id" class="btn btn-sm btn-primary" title="Ver parecer completo de validação">
                                    <i class="bi bi-search me-1"></i> Parecer
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

