@model CadastroAlunos.Models.AlunoCadastroViewModel
@{
    ViewData["Title"] = "Ficha de Cadastro e Validação de RG";
}

<div class="row justify-content-center">
    <div class="col-lg-10">
        <!-- Banner de Boas-Vindas e Acolhimento EJA -->
        <div class="card card-custom p-4 p-md-5 mb-4 border-start border-primary border-5">
            <div class="d-flex align-items-center mb-3">
                <div class="bg-primary text-white p-3 rounded-circle me-3">
                    <i class="bi bi-person-badge-fill fs-2"></i>
                </div>
                <div>
                    <h1 class="h3 fw-bold mb-1 text-primary">Cadastro do Aluno & Verificação de RG</h1>
                    <p class="text-muted mb-0 fs-6">
                        Bem-vindo! Preencha as informações abaixo e anexe a foto ou PDF do seu RG. 
                        Nosso sistema irá gravar seus dados com segurança no <strong>Firebase</strong> e conferir na hora se o documento é seu.
                    </p>
                </div>
            </div>

            <div class="alert alert-info d-flex align-items-center py-2 px-3 mb-0" role="alert">
                <i class="bi bi-info-circle-fill fs-4 me-2 text-primary"></i>
                <div>
                    <strong>Fique tranquilo(a):</strong> Se tiver dúvidas durante o preenchimento, peça auxílio ao professor ou à secretaria escolar.
                </div>
            </div>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div class="alert alert-danger card-custom p-4 mb-4" role="alert">
                <h5 class="alert-heading fw-bold mb-2">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Por favor, confira os seguintes pontos:
                </h5>
                <div asp-validation-summary="All" class="text-danger mb-0"></div>
            </div>
        }

        <!-- Formulário de Cadastro -->
        <form asp-action="Index" method="post" enctype="multipart/form-data" id="formCadastro" novalidate>
            @Html.AntiForgeryToken()

            <!-- ETAPA 1: DADOS PESSOAIS -->
            <div class="card card-custom p-4 p-md-4 mb-4">
                <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                    <span class="step-badge">1</span>
                    <h2 class="h5 fw-bold mb-0 text-dark">Quem é você? (Seus Dados Pessoais)</h2>
                </div>

                <div class="row g-3">
                    <div class="col-12">
                        <label asp-for="NomeCompleto" class="form-label"></label>
                        <input asp-for="NomeCompleto" class="form-control form-control-lg" placeholder="Digite seu nome completo igual ao que consta no RG" />
                        <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
                        <div class="form-text text-muted">
                            <i class="bi bi-lightbulb me-1"></i> Dica: Digite o nome sem abreviações, exatamente como está impresso no seu documento.
                        </div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NomeDaMae" class="form-label"></label>
                        <input asp-for="NomeDaMae" class="form-control" placeholder="Nome completo da sua mãe" />
                        <span asp-validation-for="NomeDaMae" class="text-danger small"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="NumeroRg" class="form-label"></label>
                        <input asp-for="NumeroRg" class="form-control" placeholder="Ex: 12.345.678-9 (opcional)" />
                        <span asp-validation-for="NumeroRg" class="text-danger small"></span>
                        <div class="form-text text-muted">Facilita a conferência automática do documento.</div>
                    </div>

                    <div class="col-12">
                        <div class="form-check form-switch p-2 bg-light rounded-3 mb-2">
                            <input class="form-check-input ms-0 me-2" type="checkbox" asp-for="PaiNaoDeclarado" id="checkPaiNaoDeclarado">
                            <label class="form-check-label fw-semibold" for="checkPaiNaoDeclarado">
                                Não consta nome de pai no meu documento ou certidão
                            </label>
                        </div>
                    </div>

                    <div class="col-12" id="campoNomeDoPai">
                        <label asp-for="NomeDoPai" class="form-label"></label>
                        <input asp-for="NomeDoPai" class="form-control" placeholder="Nome completo do seu pai" />
                        <span asp-validation-for="NomeDoPai" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- ETAPA 2: ENDEREÇO -->
            <div class="card card-custom p-4 p-md-4 mb-4">
                <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                    <span class="step-badge">2</span>
                    <h2 class="h5 fw-bold mb-0 text-dark">Onde você mora? (Seu Endereço)</h2>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label asp-for="Cep" class="form-label"></label>
                        <div class="input-group">
                            <input asp-for="Cep" class="form-control" id="inputCep" placeholder="00000-000" maxlength="9" />
                            <button type="button" class="btn btn-outline-primary" id="btnBuscarCep" title="Preencher endereço pelo CEP">
                                <i class="bi bi-search"></i> Buscar
                            </button>
                        </div>
                        <span asp-validation-for="Cep" class="text-danger small"></span>
                        <div id="cepFeedback" class="small mt-1 text-muted"></div>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Logradouro" class="form-label"></label>
                        <input asp-for="Logradouro" class="form-control" id="inputLogradouro" placeholder="Ex: Rua das Flores, Avenida Brasil" />
                        <span asp-validation-for="Logradouro" class="text-danger small"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Numero" class="form-label"></label>
                        <input asp-for="Numero" class="form-control" placeholder="Nº ou S/N" />
                        <span asp-validation-for="Numero" class="text-danger small"></span>
                    </div>

                    <div class="col-md-4">
                        <label asp-for="Complemento" class="form-label"></label>
                        <input asp-for="Complemento" class="form-control" placeholder="Apto, Bloco, Casa 2" />
                        <span asp-validation-for="Complemento" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Bairro" class="form-label"></label>
                        <input asp-for="Bairro" class="form-control" id="inputBairro" placeholder="Bairro" />
                        <span asp-validation-for="Bairro" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Cidade" class="form-label"></label>
                        <input asp-for="Cidade" class="form-control" id="inputCidade" placeholder="Cidade" />
                        <span asp-validation-for="Cidade" class="text-danger small"></span>
                    </div>

                    <div class="col-md-2">
                        <label asp-for="Estado" class="form-label"></label>
                        <input asp-for="Estado" class="form-control text-uppercase" id="inputEstado" placeholder="UF" maxlength="2" />
                        <span asp-validation-for="Estado" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <!-- ETAPA 3: DOCUMENTO COMPROBATÓRIO (RG) -->
            <div class="card card-custom p-4 p-md-4 mb-4 border border-2 border-primary-subtle">
                <div class="d-flex align-items-center mb-3 pb-2 border-bottom">
                    <span class="step-badge">3</span>
                    <h2 class="h5 fw-bold mb-0 text-dark">Seu Documento (RG)</h2>
                </div>

                <div class="p-3 mb-3 bg-light rounded-3">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <h6 class="fw-bold mb-1 text-dark">
                                <i class="bi bi-file-earmark-check-fill text-success me-1"></i> Requisitos do Documento:
                            </h6>
                            <ul class="mb-0 small text-muted">
                                <li>Envie o seu <strong>RG</strong> (frente e verso ou frente aberta).</li>
                                <li>Formatos aceitos: <strong>PDF</strong> ou imagem <strong>PNG</strong> (ou foto JPG).</li>
                                <li><strong>Tamanho Máximo Obrigatório: até 5 MB</strong>.</li>
                            </ul>
                        </div>
                        <div class="col-md-4 text-md-end mt-2 mt-md-0">
                            <span class="badge bg-primary fs-6 px-3 py-2">
                                <i class="bi bi-hdd-fill me-1"></i> Limite: 5 MB
                            </span>
                        </div>
                    </div>
                </div>

                <!-- Área de Seleção de Arquivo -->
                <div class="mb-3">
                    <label asp-for="Documento" class="form-label fs-6 fw-bold">Selecione o arquivo do seu RG:</label>
                    <input asp-for="Documento" type="file" class="form-control form-control-lg" id="inputDocumento" 
                           accept=".pdf,.png,.jpg,.jpeg,application/pdf,image/png,image/jpeg" />
                    <span asp-validation-for="Documento" class="text-danger small"></span>
                </div>

                <!-- Painel Informativo do Arquivo Selecionado -->
                <div id="painelArquivo" class="alert alert-secondary d-none mb-3" role="alert">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
                        <div class="d-flex align-items-center">
                            <i id="iconeArquivo" class="bi bi-file-earmark-text-fill fs-2 me-3 text-primary"></i>
                            <div>
                                <div class="fw-bold text-dark" id="nomeArquivo">arquivo.png</div>
                                <div class="small text-muted" id="tamanhoArquivo">0.00 MB</div>
                            </div>
                        </div>
                        <div>
                            <span id="badgeStatusTamanho" class="badge bg-success fs-6 py-2 px-3">
                                <i class="bi bi-check-circle-fill me-1"></i> Tamanho Adequado (<= 5MB)
                            </span>
                        </div>
                    </div>

                    <!-- Mensagem de Erro de Tamanho > 5MB -->
                    <div id="alertaArquivoGrande" class="alert alert-danger mt-3 mb-0 d-none">
                        <i class="bi bi-x-circle-fill me-2 fs-5"></i>
                        <strong>Arquivo muito grande!</strong> O arquivo selecionado ultrapassa o limite de 5 Megabytes (5MB). 
                        Por favor, tire uma nova foto ou reduza a resolução antes de enviar.
                    </div>

                    <!-- Prévia da Imagem caso seja PNG ou JPG -->
                    <div id="previewContainer" class="mt-3 text-center d-none">
                        <img id="imgPreview" src="" alt="Prévia do documento RG" class="img-fluid rounded border shadow-sm" style="max-height: 250px;" />
                    </div>
                </div>
            </div>

            <!-- BOTÃO DE ENVIO COM FEEDBACK VISUAL -->
            <div class="card card-custom p-4 text-center">
                <div class="d-grid gap-2 d-md-flex justify-content-md-center">
                    <button type="submit" class="btn btn-custom-primary btn-lg px-5 py-3 shadow" id="btnSalvar">
                        <i class="bi bi-cloud-arrow-up-fill me-2 fs-4 align-middle"></i>
                        <span class="align-middle fs-5">Gravar Dados e Conferir Meu RG</span>
                    </button>
                </div>
                <div class="small text-muted mt-2">
                    <i class="bi bi-lock-fill text-success me-1"></i> Seus dados serão gravados com segurança no Firebase e processados de acordo com a LGPD.
                </div>

                <!-- Loader durante processamento -->
                <div id="processandoEnvio" class="mt-3 d-none">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="mt-2 text-primary fw-semibold mb-0">
                        Gravando no Firebase e conferindo os dados do seu RG... Por favor, aguarde alguns instantes!
                    </p>
                </div>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        // 1. Controle de Pai Não Declarado
        const checkPaiNaoDeclarado = document.getElementById('checkPaiNaoDeclarado');
        const campoNomeDoPai = document.getElementById('campoNomeDoPai');
        const inputNomeDoPai = document.getElementById('NomeDoPai');

        function atualizarCampoPai() {
            if (checkPaiNaoDeclarado.checked) {
                campoNomeDoPai.style.opacity = '0.4';
                inputNomeDoPai.disabled = true;
                inputNomeDoPai.value = '';
            } else {
                campoNomeDoPai.style.opacity = '1';
                inputNomeDoPai.disabled = false;
            }
        }
        checkPaiNaoDeclarado.addEventListener('change', atualizarCampoPai);
        atualizarCampoPai();

        // 2. Busca Automática de CEP
        const btnBuscarCep = document.getElementById('btnBuscarCep');
        const inputCep = document.getElementById('inputCep');
        const cepFeedback = document.getElementById('cepFeedback');

        async function consultarCep() {
            const cep = inputCep.value.replace(/\D/g, '');
            if (cep.length !== 8) {
                cepFeedback.innerHTML = '<span class="text-danger">Digite os 8 números do CEP.</span>';
                return;
            }

            cepFeedback.innerHTML = '<span class="text-primary"><i class="bi bi-hourglass-split"></i> Buscando endereço...</span>';

            try {
                const response = await fetch(`/Home/BuscarCep?cep=${cep}`);
                if (response.ok) {
                    const data = await response.json();
                    if (!data.erro) {
                        document.getElementById('inputLogradouro').value = data.logradouro || '';
                        document.getElementById('inputBairro').value = data.bairro || '';
                        document.getElementById('inputCidade').value = data.localidade || '';
                        document.getElementById('inputEstado').value = data.uf || '';
                        cepFeedback.innerHTML = '<span class="text-success"><i class="bi bi-check-circle-fill"></i> Endereço localizado! Complete o número da casa.</span>';
                        document.querySelector('input[name="Numero"]').focus();
                        return;
                    }
                }
                cepFeedback.innerHTML = '<span class="text-warning"><i class="bi bi-info-circle"></i> CEP não encontrado. Preencha o endereço manualmente.</span>';
            } catch (e) {
                cepFeedback.innerHTML = '<span class="text-muted">Não foi possível buscar automaticamente. Digite o endereço abaixo.</span>';
            }
        }

        btnBuscarCep.addEventListener('click', consultarCep);
        inputCep.addEventListener('blur', () => {
            if (inputCep.value.replace(/\D/g, '').length === 8) {
                consultarCep();
            }
        });

        // 3. Validação Imediata do Arquivo (Máximo 5MB e Formato PDF/PNG)
        const inputDocumento = document.getElementById('inputDocumento');
        const painelArquivo = document.getElementById('painelArquivo');
        const nomeArquivo = document.getElementById('nomeArquivo');
        const tamanhoArquivo = document.getElementById('tamanhoArquivo');
        const iconeArquivo = document.getElementById('iconeArquivo');
        const badgeStatusTamanho = document.getElementById('badgeStatusTamanho');
        const alertaArquivoGrande = document.getElementById('alertaArquivoGrande');
        const previewContainer = document.getElementById('previewContainer');
        const imgPreview = document.getElementById('imgPreview');
        const btnSalvar = document.getElementById('btnSalvar');

        const LIMITE_BYTES = 5 * 1024 * 1024; // 5 MB

        inputDocumento.addEventListener('change', function () {
            if (!this.files || this.files.length === 0) {
                painelArquivo.classList.add('d-none');
                return;
            }

            const file = this.files[0];
            const sizeInMb = (file.size / (1024 * 1024)).toFixed(2);
            
            painelArquivo.classList.remove('d-none');
            nomeArquivo.textContent = file.name;
            tamanhoArquivo.textContent = `${sizeInMb} MB (${file.size.toLocaleString('pt-BR')} bytes)`;

            const isPdf = file.name.toLowerCase().endsWith('.pdf');
            const isImage = file.type.startsWith('image/');

            if (isPdf) {
                iconeArquivo.className = 'bi bi-file-earmark-pdf-fill fs-2 me-3 text-danger';
                previewContainer.classList.add('d-none');
            } else {
                iconeArquivo.className = 'bi bi-file-earmark-image-fill fs-2 me-3 text-primary';
                if (isImage) {
                    const reader = new FileReader();
                    reader.onload = function (e) {
                        imgPreview.src = e.target.result;
                        previewContainer.classList.remove('d-none');
                    };
                    reader.readAsDataURL(file);
                }
            }

            // Checagem de Tamanho estrita
            if (file.size > LIMITE_BYTES) {
                badgeStatusTamanho.className = 'badge bg-danger fs-6 py-2 px-3';
                badgeStatusTamanho.innerHTML = '<i class="bi bi-exclamation-octagon-fill me-1"></i> Ultrapassou 5 MB!';
                alertaArquivoGrande.classList.remove('d-none');
                btnSalvar.disabled = true;
                btnSalvar.classList.add('btn-secondary');
                btnSalvar.classList.remove('btn-custom-primary');
            } else {
                badgeStatusTamanho.className = 'badge bg-success fs-6 py-2 px-3';
                badgeStatusTamanho.innerHTML = '<i class="bi bi-check-circle-fill me-1"></i> Tamanho Adequado (<= 5MB)';
                alertaArquivoGrande.classList.add('d-none');
                btnSalvar.disabled = false;
                btnSalvar.classList.remove('btn-secondary');
                btnSalvar.classList.add('btn-custom-primary');
            }
        });

        // 4. Feedback de Carregamento ao Submeter
        document.getElementById('formCadastro').addEventListener('submit', function (e) {
            if (btnSalvar.disabled) {
                e.preventDefault();
                return;
            }
            document.getElementById('processandoEnvio').classList.remove('d-none');
            btnSalvar.disabled = true;
            btnSalvar.innerHTML = '<i class="bi bi-hourglass-split me-2"></i> Processando documento...';
        });
    </script>
}
