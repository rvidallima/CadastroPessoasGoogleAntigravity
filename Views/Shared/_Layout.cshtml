<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema EJA de Cadastro de Alunos</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CadastroAlunos.styles.css" asp-append-version="true" />
    <style>
        :root {
            --primary-color: #1a56db;
            --primary-hover: #1e429f;
            --success-color: #057a55;
            --warning-color: #c27803;
            --danger-color: #e02424;
            --card-bg: #ffffff;
            --body-bg: #f8fafc;
            --text-main: #1f2937;
        }

        body {
            background-color: var(--body-bg);
            color: var(--text-main);
            font-family: system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            font-size: 1.05rem;
            line-height: 1.6;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.3rem;
            color: var(--primary-color) !important;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .card-custom {
            border: none;
            border-radius: 1rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.06);
            background: var(--card-bg);
        }

        .btn-custom-primary {
            background-color: var(--primary-color);
            border-color: var(--primary-color);
            color: #ffffff;
            padding: 0.75rem 1.75rem;
            font-size: 1.15rem;
            font-weight: 600;
            border-radius: 0.75rem;
            transition: all 0.2s ease-in-out;
        }

        .btn-custom-primary:hover {
            background-color: var(--primary-hover);
            border-color: var(--primary-hover);
            color: #ffffff;
            transform: translateY(-1px);
        }

        .form-label {
            font-weight: 600;
            color: #374151;
            margin-bottom: 0.35rem;
        }

        .form-control, .form-select {
            padding: 0.7rem 1rem;
            font-size: 1.05rem;
            border-radius: 0.6rem;
            border: 1.5px solid #d1d5db;
        }

        .form-control:focus, .form-select:focus {
            border-color: var(--primary-color);
            box-shadow: 0 0 0 3px rgba(26, 86, 219, 0.2);
        }

        .step-badge {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 2.2rem;
            height: 2.2rem;
            border-radius: 50%;
            background-color: var(--primary-color);
            color: #fff;
            font-weight: bold;
            font-size: 1.1rem;
            margin-right: 0.6rem;
        }

        .accessibility-bar {
            background-color: #1e293b;
            color: #f1f5f9;
            font-size: 0.95rem;
            padding: 0.4rem 0;
        }

        .accessibility-bar button {
            color: #f8fafc;
            border: none;
            background: transparent;
            padding: 0.2rem 0.6rem;
            border-radius: 0.3rem;
            cursor: pointer;
        }

        .accessibility-bar button:hover {
            background: #334155;
        }
    </style>
</head>
<body>
    <div class="accessibility-bar">
        <div class="container d-flex justify-content-between align-items-center">
            <div>
                <span class="badge bg-primary me-2">EJA</span>
                <span>Educação de Jovens e Adultos - Acesso Acessível</span>
            </div>
            <div class="d-flex gap-2 align-items-center">
                <button type="button" id="btnOuvirPagina" title="Ouvir as instruções desta página em voz alta">
                    <i class="bi bi-volume-up-fill"></i> Ouvir Instruções
                </button>
                <button type="button" id="btnAumentarFonte" title="Aumentar o tamanho do texto">
                    <i class="bi bi-fonts"></i> A+
                </button>
                <button type="button" id="btnDiminuirFonte" title="Diminuir o tamanho do texto">
                    A-
                </button>
            </div>
        </div>
    </div>

    <header>
        <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom shadow-sm">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-mortarboard-fill fs-3 text-primary"></i>
                    <span>Portal do Aluno EJA</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarPrincipal" aria-controls="navbarPrincipal" aria-expanded="false" aria-label="Menu de Navegação">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarPrincipal">
                    <ul class="navbar-nav ms-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "text-primary active" : "text-dark")" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-person-plus-fill me-1"></i> Fazer Cadastro
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "Alunos" ? "text-primary active" : "text-dark")" asp-controller="Home" asp-action="Alunos">
                                <i class="bi bi-people-fill me-1"></i> Alunos Cadastrados
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link px-3 fw-semibold @(ViewContext.RouteData.Values["action"]?.ToString() == "Guia" ? "text-primary active" : "text-dark")" asp-controller="Home" asp-action="Guia">
                                <i class="bi bi-camera-fill me-1"></i> Dicas para Foto do RG
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top bg-white py-4 mt-5 text-muted">
        <div class="container text-center">
            <p class="mb-1 fw-semibold text-dark">
                <i class="bi bi-shield-check text-success me-1"></i> Sistema de Cadastro e Verificação Segura de Documentos EJA (.NET 10 & Firebase)
            </p>
            <p class="small mb-0">
                Desenvolvido com foco em acessibilidade, respeito e inclusão para Jovens e Adultos. Limite de documento: 5 MB (PDF ou PNG).
            </p>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        // Acessibilidade: Tamanho de Fonte
        let currentFontSizePercent = 100;
        document.getElementById('btnAumentarFonte')?.addEventListener('click', () => {
            if (currentFontSizePercent < 130) {
                currentFontSizePercent += 10;
                document.body.style.fontSize = (currentFontSizePercent / 100 * 1.05) + 'rem';
            }
        });
        document.getElementById('btnDiminuirFonte')?.addEventListener('click', () => {
            if (currentFontSizePercent > 90) {
                currentFontSizePercent -= 10;
                document.body.style.fontSize = (currentFontSizePercent / 100 * 1.05) + 'rem';
            }
        });

        // Acessibilidade: Leitor de Instruções em Voz Alta (Web Speech API)
        document.getElementById('btnOuvirPagina')?.addEventListener('click', () => {
            if (!('speechSynthesis' in window)) {
                alert('Seu navegador não possui suporte a leitura por voz.');
                return;
            }

            if (window.speechSynthesis.speaking) {
                window.speechSynthesis.cancel();
                return;
            }

            const textoParaFalar = document.querySelector('main')?.innerText || 'Bem-vindo ao sistema de cadastro do aluno.';
            const utterance = new SpeechSynthesisUtterance(textoParaFalar.substring(0, 1000));
            utterance.lang = 'pt-BR';
            utterance.rate = 0.95;
            window.speechSynthesis.speak(utterance);
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
